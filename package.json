{
  "name": "barbershop-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "test": "node --experimental-strip-types --test src/db.test.ts",
    "web": "node --env-file=.env --import tsx src/server.ts",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "migrate": "node --env-file=.env --import tsx scripts/migrate-sqlite.ts"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/serverless": "^1.0.1",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
